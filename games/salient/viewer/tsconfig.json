{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // The viewer is the one workspace project that runs in a browser: it needs
    // the DOM globals, and the root project excludes it so the node packages
    // never see them. `vite/client` types `import.meta.glob` and `import.meta.env`.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src"]
}
